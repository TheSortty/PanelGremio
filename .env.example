# =============================================================================
# Copiar a .env.local y completar. .env.local está en .gitignore.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publishable (antes "anon"). Se envía al navegador: es pública por diseño
# y no otorga nada por sí sola — quien manda es RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave secreta (antes "service_role"). SALTEA RLS POR COMPLETO.
# Solo para los seeds y el callback de Steam, siempre del lado del servidor.
# Sin prefijo NEXT_PUBLIC_: cualquier variable con ese prefijo se envía al navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# --- URL pública de la app ----------------------------------------------------
# Se usa para armar los redirect de OAuth. En producción, el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Steam --------------------------------------------------------------------
# Clave de la Steam Web API: https://steamcommunity.com/dev/apikey
# Opcional: sin esto el login por Steam funciona igual, pero no trae nombre ni avatar.
STEAM_API_KEY=

# --- Gemini (guías de build por IA) -------------------------------------------
# https://aistudio.google.com/apikey
# Opcional: si falta, la app arranca igual y solo se desactiva el botón de generar guía.
GEMINI_API_KEY=
